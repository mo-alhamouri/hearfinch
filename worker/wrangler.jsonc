{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearfinch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "vars": {
    // Websites allowed to call the API from a browser.
    "ALLOWED_ORIGINS": "https://mo-alhamouri.github.io,http://localhost:5173",
    "ACRCLOUD_HOST": "identify-us-west-2.acrcloud.com"
  },

  // The dialogue index for movies and TV. The GitHub workflows find or create
  // this database and fill in its id automatically. For local deploys, run
  // `npm run ci:prepare-d1` once after `npx wrangler login`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearfinch-dialogue",
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE",
      "migrations_dir": "migrations"
    }
  ],

  // Per-visitor limit on /identify: 6 clips per minute per Cloudflare location.
  "ratelimits": [
    {
      "name": "IDENTIFY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]

  // Secrets are not stored here. Add them as GitHub repository secrets and the
  // API workflow copies them to the Worker on every deploy (see worker/README.md).
}

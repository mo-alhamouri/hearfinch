# Copy to .env.local for `npm run dev`. In production these come from GitHub repository variables.

# Your Worker's URL. Leave empty to run the site in demo mode with sample results.
VITE_API_URL=http://localhost:8787

# Cloudflare Turnstile site key (optional bot check). Must match TURNSTILE_SECRET on the Worker.
VITE_TURNSTILE_SITE_KEY=
